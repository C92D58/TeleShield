# TeleShield 環境變數範例 — 複製為 .env 並填入真實值
# 位置：~/.teleshield/.env 或項目根 .env

# Telegram API 憑證（https://my.telegram.org/apps 取得）
TELESHIELD_API_ID=
TELESHIELD_API_HASH=
TELESHIELD_PHONE=

# 可選：數據目錄（默認 ~/.teleshield）
# TELESHIELD_HOME=/custom/path

# ── 自動更新 ────────────────────────────────────────────
# 檢查 GitHub Release 用。私人倉庫需要 token（repo 權限的 fine-grained token）；
# 公開倉庫可留空（但 GitHub API 對匿名請求有速率限制）。
TELESHIELD_GITHUB_TOKEN=

# ── 雲端名單同步（可選）────────────────────────────────
# 黑白名單同步到 Cloudflare KV。三個都填才會啟用；
# token 需要「Workers KV Storage: Edit」權限，且**只存在這台機器**。
TELESHIELD_CF_ACCOUNT_ID=
TELESHIELD_CF_KV_NAMESPACE_ID=
TELESHIELD_CF_API_TOKEN=

# ── 網頁儀表板 ──────────────────────────────────────────
# 預設只綁 127.0.0.1。要讓區網其他裝置看才改成 0.0.0.0（但沒有密碼保護，
# 請自行確保網路可信）。
TELESHIELD_DASHBOARD_HOST=127.0.0.1
TELESHIELD_DASHBOARD_PORT=8787
